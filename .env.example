# storekit — configuração de INFRAESTRUTURA.
# A configuração da LOJA (domínio, token, marca) vive no banco, preenchida pelo wizard.
# Gere as chaves com:  npm run genkeys >> .env

# --- obrigatórias ---------------------------------------------------------
# Chave do SQLCipher (banco inteiro cifrado at-rest). 32+ caracteres.
DB_KEY=
# 64 caracteres hex (32 bytes) para AES-256-GCM da PII.
PII_KEY=

# --- recomendadas ---------------------------------------------------------
# Segredo do JWT do painel. Em produção o boot RECUSA subir com o default.
JWT_SECRET=
# Token do endpoint /mcp (Bearer ou x-api-key). Sem ele o /mcp fica ABERTO.
MCP_TOKEN=

# --- infraestrutura (têm padrão) -----------------------------------------
# all = painel+API+MCP+ETL | web = sem agendador | worker = só ETL
ROLE=all
TENANT=default
DATA_DIR=/data
PORT=3000
LOG_LEVEL=info
# false só em HTTP local (sem TLS): o cookie de sessão não sobe em http com secure=true.
COOKIE_SECURE=true
# Versão exibida no rodapé/health/MCP.
APP_VERSION=dev
